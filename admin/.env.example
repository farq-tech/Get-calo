# Calora Admin — copy to .env.local
# Use the Calorie Scanner Supabase project (NOT Farq).

NEXT_PUBLIC_SUPABASE_URL=https://your-calorie-scanner-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role required for promote/rollback RPC and feedback review writes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
