# Farq source (READ-ONLY — dataset generation only, never inference)
FARQ_SUPABASE_URL=https://your-farq-project.supabase.co
FARQ_SUPABASE_SERVICE_KEY=your-farq-service-or-readonly-key
# Optional caps for first runs
FARQ_MAX_ROWS=20000
MAX_CLASSES=500
MIN_IMAGES_PER_CLASS=4

# Farq schema defaults (Get-calo wiring):
#   classes  = canonical_items.id  →  canonical:{id}
#   images   = provider_items.image (via canonical_item_id)
#   calories = provider_items.calories (canonical calories often null)
#   macros   = not present in Farq yet
