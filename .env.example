# ─────────────────────────────────────────────────────────────
# AI Calorie Scanner — Environment Template
# Copy to .env and fill values. NEVER commit real secrets.
# Farq Supabase is READ-ONLY for dataset generation only.
# ─────────────────────────────────────────────────────────────

# Farq source (READ-ONLY — dataset generation only, never inference)
FARQ_SUPABASE_URL=https://your-farq-project.supabase.co
FARQ_SUPABASE_SERVICE_KEY=your-farq-service-or-readonly-key
# Optional caps for first runs (0 FARQ_MAX_ROWS = fetch all linked images)
FARQ_MAX_ROWS=20000
MAX_CLASSES=500
MIN_IMAGES_PER_CLASS=4
# Schema defaults: classes=canonical_items.id → canonical:{id}
# images=provider_items.image; calories=provider_items.calories
# protein/carbs/fat not in Farq yet

# Calorie Scanner own Supabase (feedback, model registry, nutrition sync)
CALORIE_SUPABASE_URL=https://your-calorie-scanner-project.supabase.co
CALORIE_SUPABASE_ANON_KEY=your-anon-key
CALORIE_SUPABASE_SERVICE_KEY=your-service-role-key

# ML pipeline
DATASET_OUTPUT_DIR=./data/datasets
IMAGE_CACHE_DIR=./data/raw/images
YOLO_MODEL=yolov8n.pt
TRAIN_EPOCHS=100
IMG_SIZE=640
BATCH_SIZE=16
CONFIDENCE_THRESHOLD=0.45
MIN_MAP50_ACCEPT=0.55

# Mobile (Expo public)
EXPO_PUBLIC_SUPABASE_URL=https://your-calorie-scanner-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_MODEL_CDN_URL=https://cdn.example.com/models

# Admin
NEXT_PUBLIC_SUPABASE_URL=https://your-calorie-scanner-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
